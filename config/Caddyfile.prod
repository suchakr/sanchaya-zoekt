:6070 {
    handle /labs* {
        root * /srv
        try_files {path} {path}/ /labs/index.html
        file_server
    }

    handle /help* {
        redir * /?section=help 302
    }

    handle /about* {
        redir * /?section=about 302
    }

    # Zoekt JSON RPC is for the private retrieval companion.  Do not expose
    # it through the public :6070 listener.
    handle /api* {
        respond 404
    }

    handle {
        reverse_proxy zoekt-webserver:6070 {
            header_up Host {http.request.host}
        }
    }
}

sanchaya.rasowshi.us {
    tls {
        protocols tls1.2 tls1.3
    }

    encode zstd gzip

    handle /labs* {
        root * /srv
        try_files {path} {path}/ /labs/index.html
        file_server
    }

    handle /help* {
        redir * /?section=help 302
    }

    handle /about* {
        redir * /?section=about 302
    }

    # MCP is the only new public API surface. OAuth is the default route;
    # the bearer path remains available for existing clients and rollback.
    @oauth_metadata path /.well-known/* /authorize /token /register /revoke /oauth/callback
    handle @oauth_metadata {
        reverse_proxy retrieval-mcp-oauth:8788 {
            header_up Host {http.request.host}
            header_up X-Real-IP {http.request.remote}
            header_up X-Forwarded-For {http.request.remote}
            header_up X-Forwarded-Proto {http.request.scheme}
        }
    }

    @oauth_alias path /mcp-oauth /mcp-oauth/*
    handle @oauth_alias {
        handle_path /mcp-oauth* {
            rewrite * /mcp
            reverse_proxy retrieval-mcp-oauth:8788 {
                header_up Host {http.request.host}
                header_up X-Real-IP {http.request.remote}
                header_up X-Forwarded-For {http.request.remote}
                header_up X-Forwarded-Proto {http.request.scheme}
            }
        }
    }

    @oauth_mcp path /mcp /mcp/*
    handle @oauth_mcp {
        reverse_proxy retrieval-mcp-oauth:8788 {
            header_up Host {http.request.host}
            header_up X-Real-IP {http.request.remote}
            header_up X-Forwarded-For {http.request.remote}
            header_up X-Forwarded-Proto {http.request.scheme}
        }
    }

    @bearer_mcp path /mcp-bearer /mcp-bearer/*
    handle @bearer_mcp {
        handle_path /mcp-bearer* {
            rewrite * /mcp
            reverse_proxy retrieval-mcp:8787 {
                header_up Host {http.request.host}
                header_up X-Real-IP {http.request.remote}
                header_up X-Forwarded-For {http.request.remote}
                header_up X-Forwarded-Proto {http.request.scheme}
            }
        }
    }

    # Keep raw Zoekt RPC private to the Docker network.
    handle /api* {
        respond 404
    }

    handle {
        reverse_proxy zoekt-webserver:6070 {
            header_up Host {http.request.host}
            header_up X-Real-IP {http.request.remote}
            header_up X-Forwarded-For {http.request.remote}
            header_up X-Forwarded-Proto {http.request.scheme}
        }
    }

    log {
        output file /var/log/caddy/access.log
        format console
    }
}
